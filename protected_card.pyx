# cython: language_level=3
# cython: boundscheck=False
# cython: wraparound=False

import os, sys, hashlib, marshal, zlib, struct


ENCRYPTED = bytes.fromhex("")
INTEGRITY = bytes.fromhex("ba3538d26c5270f7dcaefb71b4d8eca3a52d1c21ce3d2f308b024db7fc98ff11")
KEY_BYTES = bytes.fromhex("81ade675849b8837fe9ab707982a1abd53af4f96ac47570719ab623bb90de89c")


def _xor_bytes(data, key):
    return bytes(data[i] ^ key[i % len(key)] for i in range(len(data)))


def _generate_keystream(data_len):
    sha_key = hashlib.sha256(KEY_BYTES).digest()
    stream = bytearray()
    counter = 0
    while len(stream) < data_len:
        stream.extend(hashlib.sha256(struct.pack(">I", counter) + sha_key).digest())
        counter += 1
    return bytes(stream[:data_len])


def _decrypt():
    if hashlib.sha256(ENCRYPTED).digest() != INTEGRITY:
        raise ValueError("Integrity check failed")
    keystream = _generate_keystream(len(ENCRYPTED))
    decrypted = _xor_bytes(ENCRYPTED, keystream)
    return marshal.loads(zlib.decompress(decrypted))


def run():
    try:
        code_obj = _decrypt()
        runtime_file = os.path.abspath(sys.argv[0])
        namespace = {
            "__name__": "__main__",
            "__file__": runtime_file,
            "__builtins__": __builtins__,
            "__path__": os.path.dirname(runtime_file),
        }
        exec(code_obj, namespace)
    except Exception as e:
        print(f"[RUNTIME ERROR] {e}")
        raise


if __name__ == "__main__":
    run()
